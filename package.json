{
  "name": "petdock",
  "version": "0.1.1",
  "description": "A transparent Electron desktop pet dock powered by spritesheet atlases.",
  "author": "xrrii",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "debug": "cross-env DESKTOP_PET_DEVTOOLS=1 electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "python-runtime\\.venv\\Scripts\\python.exe -m pytest -q python-runtime\\tests --basetemp temp\\pytest-runtime",
    "test:retrieval": "python-runtime\\.venv\\Scripts\\python.exe tools\\evaluate_retrieval.py",
    "test:runtime:packaged": "node tools/runtime_smoke.mjs",
    "test:e2e:assistant": "npm run build && node tools/assistant_smoke.mjs",
    "test:e2e:assistant:dev": "cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-dev.png node tools/assistant_smoke.mjs",
    "test:e2e:assistant:packaged": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-packaged.png node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c2": "cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_C2_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs && cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_C2_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 PETDOCK_SMOKE_ARTIFACT_SAVE_CANCEL_ONCE=1 PETDOCK_SMOKE_ARTIFACT_SAVE_CANCEL_ONLY=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c2:packaged": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_C2_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs && cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_C2_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 PETDOCK_SMOKE_ARTIFACT_SAVE_CANCEL_ONCE=1 PETDOCK_SMOKE_ARTIFACT_SAVE_CANCEL_ONLY=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c3": "cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_C3_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c3:packaged": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_C3_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c5": "cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_C5_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:c5:packaged": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_C5_ONLY=1 PETDOCK_SMOKE_DISABLE_GPU=1 node tools/assistant_smoke.mjs",
    "test:e2e:assistant:langchain": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-langchain.png PETDOCK_SMOKE_BACKEND=langchain node tools/assistant_smoke.mjs",
    "build": "electron-vite build",
    "build:runtime": "node tools/build_runtime.mjs",
    "licenses": "node tools/generate_third_party_notices.mjs",
    "check": "npm run typecheck && npm test && npm run test:runtime && npm run test:retrieval && npm run build",
    "preview": "electron-vite preview",
    "pack": "npm run licenses && npm run build && npm run build:runtime && electron-builder --dir",
    "dist": "npm run licenses && npm run build && npm run build:runtime && electron-builder"
  },
  "build": {
    "appId": "com.local.petdock",
    "productName": "PetDock",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-runtime/dist/petdock-assistant.exe",
        "to": "python-runtime/petdock-assistant.exe"
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE"
      },
      {
        "from": "ASSET_LICENSES.md",
        "to": "legal/ASSET_LICENSES.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "THIRD_PARTY_LICENSES.txt",
        "to": "legal/THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "THIRD_PARTY_SERVICES.md",
        "to": "legal/THIRD_PARTY_SERVICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "legal/PRIVACY.md"
      }
    ],
    "win": {
      "icon": "assets/app/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "assets/app/icon.ico",
      "uninstallerIcon": "assets/app/icon.ico",
      "installerHeaderIcon": "assets/app/icon.ico",
      "artifactName": "PetDock Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "PetDock Portable ${version}.${ext}"
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "jsdom": "^29.1.1",
    "markdown-it": "^14.3.0"
  }
}
