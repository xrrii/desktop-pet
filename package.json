{
  "name": "petdock",
  "version": "0.1.1",
  "description": "A transparent Electron desktop pet dock powered by spritesheet atlases.",
  "author": "Local",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "debug": "cross-env DESKTOP_PET_DEVTOOLS=1 electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "python-runtime\\.venv\\Scripts\\python.exe -m pytest -q python-runtime\\tests",
    "test:retrieval": "python-runtime\\.venv\\Scripts\\python.exe tools\\evaluate_retrieval.py",
    "test:runtime:packaged": "node tools/runtime_smoke.mjs",
    "test:e2e:assistant": "npm run build && node tools/assistant_smoke.mjs",
    "test:e2e:assistant:dev": "cross-env PETDOCK_SMOKE_DEV=1 PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-dev.png node tools/assistant_smoke.mjs",
    "test:e2e:assistant:packaged": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-packaged.png node tools/assistant_smoke.mjs",
    "test:e2e:assistant:langchain": "cross-env PETDOCK_SMOKE_EXECUTABLE=release\\win-unpacked\\PetDock.exe PETDOCK_SMOKE_SCREENSHOT=outputs\\assistant-stage1-langchain.png PETDOCK_SMOKE_BACKEND=langchain node tools/assistant_smoke.mjs",
    "build": "electron-vite build",
    "build:runtime": "cross-env PYTHONNOUSERSITE=1 python-runtime\\.venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean --onefile --name petdock-assistant --specpath python-runtime/build --distpath python-runtime/dist --workpath python-runtime/build --hidden-import chromadb.api.rust --hidden-import chromadb.telemetry.product.posthog --hidden-import onnxruntime --hidden-import tokenizers --collect-data chromadb --exclude-module chromadb.test --exclude-module pytest --exclude-module _pytest python-runtime/app.py",
    "check": "npm run typecheck && npm test && npm run test:runtime && npm run test:retrieval && npm run build",
    "preview": "electron-vite preview",
    "pack": "npm run build && npm run build:runtime && electron-builder --dir",
    "dist": "npm run build && npm run build:runtime && electron-builder"
  },
  "build": {
    "appId": "com.local.petdock",
    "productName": "PetDock",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-runtime/dist/petdock-assistant.exe",
        "to": "python-runtime/petdock-assistant.exe"
      }
    ],
    "win": {
      "icon": "assets/app/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "installerIcon": "assets/app/icon.ico",
      "uninstallerIcon": "assets/app/icon.ico",
      "installerHeaderIcon": "assets/app/icon.ico",
      "artifactName": "PetDock Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "PetDock Portable ${version}.${ext}"
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
