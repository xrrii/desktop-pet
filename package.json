{
  "name": "desktop-pets",
  "version": "0.1.0",
  "description": "A transparent Electron desktop pet powered by a spritesheet atlas.",
  "author": "Local",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "dev": "electron-vite dev",
    "debug": "cross-env DESKTOP_PET_DEVTOOLS=1 electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.local.desktopPets",
    "productName": "Desktop Pets",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "electron": "28.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
